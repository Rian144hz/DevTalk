{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node",
      "vitest/globals"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "src/main",
    "src/preload",
    "src/core",
    "src/shared",
    "tests",
    "scripts",
    "*.config.ts"
  ],
  "exclude": [
    "tests/e2e",
    "playwright.config.ts"
  ]
}
