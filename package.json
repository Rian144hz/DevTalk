{
  "name": "devtalk",
  "version": "0.1.0",
  "description": "English practice for developers: produce, get corrected, review.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test:core": "vitest run --project core",
    "test:main": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --project main",
    "test": "npm run test:core && npm run test:renderer && npm run test:supabase && npm run test:main",
    "postinstall": "electron-builder install-app-deps",
    "cli": "electron-vite build && electron .",
    "test:renderer": "vitest run --project renderer",
    "test:supabase": "vitest run --project supabase",
    "build:setup-sql": "node scripts/build-setup-sql.mts",
    "build:edge": "node scripts/build-edge.mts",
    "gen:stack-icons": "node scripts/gen-stack-icons.mts",
    "test:e2e": "electron-vite build && playwright test"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@google/genai": "2.29.1",
    "@supabase/supabase-js": "2.117.3",
    "better-sqlite3": "13.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "cross-env": "7.0.3",
    "electron": "44.7.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "simple-icons": "16.35.0",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false,
    "protobufjs": false
  },
  "private": true
}
